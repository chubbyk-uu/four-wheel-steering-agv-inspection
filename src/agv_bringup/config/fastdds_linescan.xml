<?xml version="1.0" encoding="UTF-8"?>
<!-- 4096x4096 Mono8 = 16 MiB. Several payloads plus transport overhead fit
     within a 128 MiB SHM segment. Apply only to GZ image-writer processes;
     readers map the writer's segment. This is transport space, not an
     unbounded image queue or an end-to-end delivery acknowledgement. -->
<dds xmlns="http://www.eprosima.com"><profiles>
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>agv_linescan_shm</transport_id><type>SHM</type>
      <segment_size>134217728</segment_size><port_queue_capacity>4096</port_queue_capacity>
      <maxMessageSize>524288</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>agv_linescan_udp</transport_id><type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize><receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="agv_linescan" is_default_profile="true"><rtps>
    <userTransports><transport_id>agv_linescan_shm</transport_id><transport_id>agv_linescan_udp</transport_id></userTransports>
    <useBuiltinTransports>false</useBuiltinTransports>
  </rtps></participant>
</profiles></dds>
