<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv">
  <xacro:arg name="platform" default="$(find agv_description)/config/platform.yaml"/>
  <xacro:arg name="controllers" default="$(find agv_description)/config/controllers.yaml"/>
  <xacro:arg name="actual_wheel_diameter" default="0"/>
  <xacro:property name="p" value="${xacro.load_yaml('$(arg platform)')}"/>
  <!-- Physical tyre only; control/odometry retain platform.wheel_radius. -->
  <xacro:property name="actual_diameter" value="${float('$(arg actual_wheel_diameter)')}"/>
  <xacro:property name="physical_radius" value="${actual_diameter/2 if actual_diameter > 0 else p.wheel_radius}"/>
  <xacro:arg name="camera_config" default="$(find agv_description)/config/linescan.yaml"/>
  <xacro:property name="cam" value="${xacro.load_yaml('$(arg camera_config)')}"/>
  <xacro:property name="camera_height" value="${cam.nominal_width_m*cam.focal_length_m/(cam.width*cam.pixel_pitch_m)}"/>
  <xacro:property name="flex" value="${cam.get('mount_flex', dict(enabled=False))}"/>
  <xacro:property name="flexible" value="${flex.get('enabled',False)}"/>
  <xacro:property name="camera_mass" value="${1.0}"/>
  <xacro:property name="camera_carrier_mass" value="${2.9}"/>
  <xacro:property name="camera_carrier_com_x" value="${0.07}"/>
  <xacro:property name="lid" value="${xacro.load_yaml('$(find agv_description)/config/lidar.yaml')}"/>
  <material name="orange"><color rgba="1 0.23 0.025 1"/></material>
  <material name="white"><color rgba="0.85 0.87 0.89 1"/></material>
  <material name="metal"><color rgba="0.35 0.38 0.40 1"/></material>
  <material name="lidar_blue"><color rgba="0.04 0.18 0.30 1"/></material>
  <material name="tire"><color rgba="0.045 0.045 0.045 1"/></material>
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial><mass value="${m}"/><inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
  </xacro:macro>
  <xacro:macro name="box_visual" params="x y z xyz rpy color">
    <visual><origin xyz="${xyz}" rpy="${rpy}"/><geometry><box size="${x} ${y} ${z}"/></geometry><material name="${color}"/></visual>
  </xacro:macro>
  <!-- Large 550 kg AGV; base_link nominally 0.65m above ground. Battery is low. -->
  <link name="base_link">
    <xacro:box_inertia m="${p.mass-340.2}" x="1.90" y="1.10" z="0.50"/>
    <visual><geometry><mesh filename="file://$(find agv_description)/meshes/large_body.obj"/></geometry><material name="orange"/></visual>
    <collision><geometry><mesh filename="file://$(find agv_description)/meshes/large_body.obj"/></geometry></collision>
    <xacro:box_visual x="0.96" y="0.74" z="0.025" xyz="0 0 0.4375" rpy="0 0 0" color="white"/>
    <xacro:box_visual x="0.46" y="0.74" z="0.018" xyz="0.71 0 0.373" rpy="0 0.2797 0" color="white"/>
    <xacro:box_visual x="0.46" y="0.74" z="0.018" xyz="-0.71 0 0.373" rpy="0 -0.2797 0" color="white"/>
    <xacro:box_visual x="1.80" y="0.025" z="0.14" xyz="0 0.558 0.12" rpy="0 0 0" color="white"/>
    <xacro:box_visual x="1.80" y="0.025" z="0.14" xyz="0 -0.558 0.12" rpy="0 0 0" color="white"/>
    <xacro:macro name="trim" params="sign">
      <xacro:box_visual x="0.018" y="0.32" z="0.13" xyz="${sign*.957} 0.32 0.15" rpy="0 0 0" color="tire"/>
      <xacro:box_visual x="0.018" y="0.32" z="0.13" xyz="${sign*.957} -0.32 0.15" rpy="0 0 0" color="tire"/>
      <xacro:box_visual x="0.02" y="0.18" z="0.018" xyz="${sign*.971} 0.32 0.15" rpy="0 0 0" color="orange"/>
      <xacro:box_visual x="0.02" y="0.18" z="0.018" xyz="${sign*.971} -0.32 0.15" rpy="0 0 0" color="orange"/>
    </xacro:macro>
    <xacro:trim sign="1"/><xacro:trim sign="-1"/>
    <!-- Rear antenna shelf below the roof edge; longer posts retain antenna height. -->
    <xacro:box_visual x="0.20" y="1.24" z="0.04" xyz="-0.85 0 0.235" rpy="0 0 0" color="orange"/>
    <collision><origin xyz="-0.85 0 0.235"/><geometry><box size="0.20 1.24 0.04"/></geometry></collision>
    <xacro:macro name="gnss_post" params="sign">
      <xacro:box_visual x="0.035" y="0.035" z="0.26" xyz="-0.85 ${sign*p.gnss_baseline/2} 0.385" rpy="0 0 0" color="white"/>
      <collision><origin xyz="-0.85 ${sign*p.gnss_baseline/2} 0.385"/><geometry><box size="0.035 0.035 0.26"/></geometry></collision>
    </xacro:macro>
    <xacro:gnss_post sign="1"/><xacro:gnss_post sign="-1"/>
    <!-- Short front camera frame and lower, forward-aiming LED arms. -->
    <xacro:macro name="front_arm" params="y">
      <!-- Bolt to the front vertical face below the opening lid; uprights stay ahead of x=.95. -->
      <xacro:box_visual x="0.08" y="0.08" z="0.12" xyz="0.97 ${y} 0.15" rpy="0 0 0" color="white"/>
      <collision><origin xyz="0.97 ${y} 0.15"/><geometry><box size="0.08 0.08 0.12"/></geometry></collision>
      <xacro:box_visual x="0.04" y="0.04" z="${0.81-(cam.led_height_m+0.035)}" xyz="0.94 ${y} ${(0.81+cam.led_height_m+0.035)/2-cam.base_nominal_height_m}" rpy="0 0 0" color="metal"/>
      <collision><origin xyz="0.94 ${y} ${(0.81+cam.led_height_m+0.035)/2-cam.base_nominal_height_m}"/><geometry><box size="0.04 0.04 ${0.81-(cam.led_height_m+0.035)}"/></geometry></collision>
      <xacro:box_visual x="${cam.camera_x_m+cam.led_forward_offset_m-0.92+0.02}" y="0.04" z="0.04" xyz="${(0.92+cam.camera_x_m+cam.led_forward_offset_m+0.02)/2} ${y} ${cam.led_height_m+0.035-cam.base_nominal_height_m}" rpy="0 0 0" color="metal"/>
      <collision><origin xyz="${(0.92+cam.camera_x_m+cam.led_forward_offset_m+0.02)/2} ${y} ${cam.led_height_m+0.035-cam.base_nominal_height_m}"/><geometry><box size="${cam.camera_x_m+cam.led_forward_offset_m-0.92+0.02} 0.04 0.04"/></geometry></collision>
    </xacro:macro>
    <xacro:front_arm y="0.24"/><xacro:front_arm y="-0.24"/>
    <visual><origin xyz="0 0 0.48"/><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="orange"/></visual>
  </link>
  <link name="battery_link">
    <xacro:box_inertia m="200" x="0.72" y="${p.body_width}" z="0.4984"/>
    <xacro:box_visual x="0.72" y="${p.body_width}" z="0.4984" xyz="0 0 0" rpy="0 0 0" color="orange"/>
    <collision><geometry><box size="0.72 ${p.body_width} 0.4984"/></geometry></collision>
  </link>
  <joint name="battery_mount" type="fixed"><parent link="base_link"/><child link="battery_link"/><origin xyz="0 0 -0.1492"/></joint>
  <xacro:macro name="gnss" params="name sign">
    <link name="gnss_${name}_link"><xacro:box_inertia m="0.6" x="0.14" y="0.14" z="0.035"/>
      <visual><geometry><cylinder radius="0.07" length="0.035"/></geometry><material name="white"/></visual>
      <collision><geometry><cylinder radius="0.07" length="0.035"/></geometry></collision>
    </link>
    <joint name="gnss_${name}_mount" type="fixed"><parent link="base_link"/><child link="gnss_${name}_link"/><origin xyz="-0.85 ${sign*p.gnss_baseline/2} ${p.gnss_top_height-p.base_height-.0175}"/></joint>
  </xacro:macro>
  <xacro:gnss name="left" sign="1"/><xacro:gnss name="right" sign="-1"/>
  <!-- C8 appearance and collision, mounted upside-down; scan model follows separately. -->
  <xacro:macro name="lidar" params="name sign">
    <link name="lidar_${name}_link"><xacro:box_inertia m="1" x="0.10" y="0.10" z="0.08"/>
      <visual><geometry><cylinder radius="0.05" length="0.08"/></geometry><material name="metal"/></visual>
      <visual><origin xyz="0 0 0.012"/><geometry><cylinder radius="0.051" length="0.045"/></geometry><material name="lidar_blue"/></visual>
      <collision><geometry><cylinder radius="0.05" length="0.08"/></geometry></collision>
      <xacro:box_visual x="0.16" y="0.13" z="0.14" xyz="0 0 -0.11" rpy="0 0 0" color="white"/>
      <collision><origin xyz="0 0 -0.11"/><geometry><box size="0.16 0.13 0.14"/></geometry></collision>
    </link>
    <gazebo reference="lidar_${name}_link">
      <sensor name="lidar_${name}" type="gpu_lidar">
        <topic>/lidar/${name}</topic><gz_frame_id>lidar_${name}_link</gz_frame_id>
        <update_rate>${lid.rate_hz}</update_rate><always_on>true</always_on><visualize>false</visualize>
        <lidar><scan><horizontal><samples>${lid.horizontal_samples}</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi-2*pi/lid.horizontal_samples}</max_angle></horizontal>
          <vertical><samples>${lid.channels}</samples><resolution>1</resolution><min_angle>${lid.vertical_min_deg*pi/180}</min_angle><max_angle>${lid.vertical_max_deg*pi/180}</max_angle></vertical></scan>
          <range><min>${lid.min_range_m}</min><max>${lid.max_range_m}</max><resolution>0.01</resolution></range>
          <noise type="gaussian"><mean>0</mean><stddev>${lid.range_noise_stddev_m}</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
    <joint name="lidar_${name}_mount" type="fixed"><parent link="base_link"/><child link="lidar_${name}_link"/><origin xyz="0.79 ${sign*.585} 0.015" rpy="${pi} 0 0"/></joint>
  </xacro:macro>
  <xacro:lidar name="left" sign="1"/><xacro:lidar name="right" sign="-1"/>
  <xacro:macro name="tread" params="i">
    <xacro:if value="${i &lt; 24}">
      <visual><origin xyz="${(physical_radius-.004)*sin(i*pi/12)} 0 ${(physical_radius-.004)*cos(i*pi/12)}" rpy="0 ${i*pi/12} 0"/><geometry><box size="0.038 ${p.wheel_width*.86} 0.008"/></geometry><material name="tire"/></visual>
      <xacro:tread i="${i+1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="spring_rings" params="i">
    <xacro:if value="${i &lt; 8}">
      <visual><origin xyz="-0.045 0 ${.005+i*.02}"/><geometry><cylinder radius="0.033" length="0.005"/></geometry><material name="metal"/></visual>
      <xacro:spring_rings i="${i+1}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_suspension_link">
      <xacro:box_inertia m="3" x="0.15" y="0.15" z="0.14"/>
      <xacro:box_visual x="0.15" y="0.15" z="0.08" xyz="0 0 0" rpy="0 0 0" color="metal"/>
      <xacro:box_visual x="0.028" y="0.028" z="0.20" xyz="0.045 0 0.09" rpy="0 0 0" color="white"/>
      <visual><origin xyz="-0.045 0 0.08"/><geometry><cylinder radius="0.025" length="0.17"/></geometry><material name="tire"/></visual>
      <xacro:spring_rings i="${0}"/>
    </link>
    <joint name="${name}_suspension_joint" type="prismatic">
      <parent link="base_link"/><child link="${name}_suspension_link"/><origin xyz="${x} ${y} -0.15"/><axis xyz="0 0 1"/>
      <limit lower="${-p.suspension_travel}" upper="${p.suspension_travel}" effort="15000" velocity="1"/>
      <dynamics damping="${p.suspension_damping}" friction="0"/>
    </joint>
    <gazebo reference="${name}_suspension_joint"><springStiffness>${p.suspension_stiffness}</springStiffness><springReference>${p.get('suspension_preload_front' if x > 0 else 'suspension_preload_rear', p.suspension_preload)}</springReference></gazebo>
    <link name="${name}_steer_link">
      <xacro:box_inertia m="12" x="0.16" y="0.20" z="0.20"/>
      <xacro:box_visual x="0.15" y="0.19" z="0.09" xyz="0 0 0" rpy="0 0 0" color="metal"/>
      <xacro:box_visual x="0.065" y="0.025" z="0.20" xyz="0 0.105 -0.10" rpy="0 0 0" color="white"/>
      <xacro:box_visual x="0.065" y="0.025" z="0.20" xyz="0 -0.105 -0.10" rpy="0 0 0" color="white"/>
      <collision><geometry><box size="0.15 0.19 0.09"/></geometry></collision>
    </link>
    <joint name="${name}_steer_joint" type="revolute"><parent link="${name}_suspension_link"/><child link="${name}_steer_link"/>
      <origin xyz="0 0 -0.10"/><axis xyz="0 0 1"/>
      <limit lower="${p.steer_hard_lower}" upper="${p.steer_hard_upper}" effort="${p.steer_effort}" velocity="${p.steer_rate}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
    <link name="${name}_wheel_link">
      <inertial><mass value="18.0"/><inertia ixx="${18*(3*physical_radius**2+p.wheel_width**2)/12}" iyy="${18*physical_radius**2/2}" izz="${18*(3*physical_radius**2+p.wheel_width**2)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
      <xacro:tread i="${0}"/>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${physical_radius-.006}" length="${p.wheel_width}"/></geometry><material name="tire"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${physical_radius}" length="${p.wheel_width}"/></geometry></collision>
      <visual><origin xyz="0 ${p.wheel_width/2+0.002} 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.085" length="0.006"/></geometry><material name="metal"/></visual>
      <visual><origin xyz="0 ${-p.wheel_width/2-0.002} 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.085" length="0.006"/></geometry><material name="metal"/></visual>
    </link>
    <joint name="${name}_drive_joint" type="continuous"><parent link="${name}_steer_link"/><child link="${name}_wheel_link"/>
      <origin xyz="0 0 -0.20"/><axis xyz="0 1 0"/><limit effort="${p.drive_effort}" velocity="${p.max_speed/p.wheel_radius}"/><dynamics damping="0.02"/></joint>
    <gazebo reference="${name}_wheel_link">
      <mu1>0.8</mu1><mu2>0.8</mu2><kp>1000000</kp><kd>100</kd>
      <!-- Per-physics-step evidence for rare wheel / triangle-mesh impulses. The
           line-scan plugin reads the GZ component into a bounded RAM ring and
           adds no ROS stream or normal-path disk writes. -->
      <sensor name="${name}_wheel_contact" type="contact">
        <always_on>true</always_on><update_rate>1000</update_rate>
        <contact><collision>${name}_wheel_link_collision</collision></contact>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:wheel name="fl" x="${p.wheelbase/2}" y="${p.track/2}"/>
  <xacro:wheel name="fr" x="${p.wheelbase/2}" y="${-p.track/2}"/>
  <xacro:wheel name="rl" x="${-p.wheelbase/2}" y="${p.track/2}"/>
  <xacro:wheel name="rr" x="${-p.wheelbase/2}" y="${-p.track/2}"/>
  <!-- Nominal optics geometry; the visible LED uses overlapping, shadow-casting spot lights. -->
  <link name="camera_link"><xacro:box_inertia m="${camera_mass}" x="0.10" y="0.12" z="0.08"/><xacro:box_visual x="0.10" y="0.12" z="0.08" xyz="0 0 0" rpy="0 0 0" color="metal"/><collision><geometry><box size="0.10 0.12 0.08"/></geometry></collision></link>
  <!-- Two equivalent bending modes of the upper bracket. Physical springs,
       no prescribed pose/noise. LED arms and lower mounting blocks stay rigid. -->
    <link name="camera_roll_link"><xacro:box_inertia m="0.1" x="0.08" y="0.54" z="0.02"/></link>
    <joint name="camera_roll_joint" type="${'revolute' if flexible else 'fixed'}">
      <parent link="base_link"/><child link="camera_roll_link"/><origin xyz="${flex['pivot_x_m']} 0 ${flex['pivot_z_m']}"/><axis xyz="1 0 0"/>
      <limit lower="-0.0872664626" upper="0.0872664626" effort="1000" velocity="5"/>
      <dynamics damping="${flex.get('damping_nms_rad',5.0)}"/>
    </joint>
    <xacro:if value="${flexible}"><gazebo reference="camera_roll_joint"><springStiffness>${flex['stiffness_nm_rad']}</springStiffness><springReference>0</springReference></gazebo></xacro:if>
    <link name="camera_carrier_link">
      <inertial><origin xyz="${camera_carrier_com_x} 0 0.15"/><mass value="${camera_carrier_mass}"/>
        <inertia ixx="${camera_carrier_mass*(.54**2+.30**2)/12}" iyy="${camera_carrier_mass*(.17**2+.30**2)/12}" izz="${camera_carrier_mass*(.17**2+.54**2)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <xacro:macro name="moving_arm" params="y">
        <xacro:box_visual x="0.04" y="0.04" z="0.30" xyz="0 ${y} 0.15" rpy="0 0 0" color="white"/>
        <collision><origin xyz="0 ${y} 0.15"/><geometry><box size="0.04 0.04 0.30"/></geometry></collision>
        <xacro:box_visual x="0.17" y="0.035" z="0.035" xyz="0.06 ${y} 0.30" rpy="0 0 0" color="white"/>
        <collision><origin xyz="0.06 ${y} 0.30"/><geometry><box size="0.17 0.035 0.035"/></geometry></collision>
      </xacro:macro>
      <xacro:moving_arm y="0.24"/><xacro:moving_arm y="-0.24"/>
      <xacro:box_visual x="0.05" y="0.54" z="0.03" xyz="0.095 0 0.30" rpy="0 0 0" color="white"/>
    </link>
    <joint name="camera_pitch_joint" type="${'revolute' if flexible else 'fixed'}">
      <parent link="camera_roll_link"/><child link="camera_carrier_link"/><axis xyz="0 1 0"/>
      <limit lower="-0.0872664626" upper="0.0872664626" effort="1000" velocity="5"/>
      <dynamics damping="${flex.get('damping_nms_rad',5.0)}"/>
    </joint>
    <!-- Balance gravity at the nominal level pose, not an added oscillation.
         Camera and carrier mass properties above also define this preload. -->
    <xacro:if value="${flexible}"><gazebo reference="camera_pitch_joint"><springStiffness>${flex['stiffness_nm_rad']}</springStiffness><springReference>${-9.81*(camera_carrier_mass*camera_carrier_com_x+camera_mass*(cam.camera_x_m-flex['pivot_x_m']))/flex['stiffness_nm_rad']}</springReference></gazebo></xacro:if>
    <joint name="camera_mount" type="fixed"><parent link="camera_carrier_link"/><child link="camera_link"/><origin xyz="${cam.camera_x_m-flex['pivot_x_m']} 0 ${camera_height-cam.base_nominal_height_m+0.04-flex['pivot_z_m']}"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 -0.04" rpy="${pi} 0 ${pi/2}"/></joint>
  <link name="led_link"><xacro:box_inertia m="1.0" x="0.035" y="${cam.led_length_m}" z="0.035"/><xacro:box_visual x="0.035" y="${cam.led_length_m}" z="0.035" xyz="0 0 0" rpy="0 0 0" color="white"/><collision><geometry><box size="0.035 ${cam.led_length_m} 0.035"/></geometry></collision></link>
  <joint name="led_mount" type="fixed"><parent link="base_link"/><child link="led_link"/><origin xyz="${cam.camera_x_m+cam.led_forward_offset_m} 0 ${cam.led_height_m-cam.base_nominal_height_m}" rpy="0 ${atan(cam.led_forward_offset_m/cam.led_height_m)} 0"/></joint>
  <!-- One physical strip, approximated by a row of lenses. Attach to base_link
       so URDF fixed-joint reduction cannot detach the lights from the vehicle. -->
  <xacro:macro name="led_spots" params="i count">
    <xacro:if value="${i &lt; count}">
      <xacro:property name="fraction" value="${2.0*i/(count-1)-1}"/>
      <xacro:property name="tilt" value="${atan(cam.led_forward_offset_m/cam.led_height_m)}"/>
      <xacro:property name="lx" value="${cam.camera_x_m+cam.led_forward_offset_m-0.022*sin(tilt)}"/>
      <xacro:property name="lz" value="${cam.led_height_m-0.022*cos(tilt)}"/>
      <xacro:property name="ly" value="${(cam.led_length_m/2-.02)*fraction}"/>
      <xacro:property name="target_y" value="${0.8*cam.radiometry.led_half_width_m*fraction}"/>
      <xacro:property name="distance" value="${sqrt((cam.camera_x_m-lx)**2+(target_y-ly)**2+lz**2)}"/>
      <gazebo reference="base_link">
        <light name="led_strip_${i}" type="spot">
          <pose>${lx} ${ly} ${lz-cam.base_nominal_height_m} 0 0 0</pose>
          <diffuse>1 1 1 1</diffuse><specular>1 1 1 1</specular>
          <intensity>${cam.gz_led.intensity_at_reference*cam.radiometry.led_peak_relative/40.0}</intensity>
          <direction>${(cam.camera_x_m-lx)/distance} ${(target_y-ly)/distance} ${-lz/distance}</direction>
          <attenuation><range>2</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
          <spot><inner_angle>${1.2*atan(cam.radiometry.led_half_depth_m/sqrt(cam.led_height_m**2+cam.led_forward_offset_m**2))}</inner_angle><outer_angle>${2.0*atan(cam.radiometry.led_half_depth_m/sqrt(cam.led_height_m**2+cam.led_forward_offset_m**2))}</outer_angle><falloff>1</falloff></spot>
          <cast_shadows>true</cast_shadows>
        </light>
      </gazebo>
      <xacro:led_spots i="${i+1}" count="${count}"/>
    </xacro:if>
  </xacro:macro>
  <xacro:if value="${cam.gz_led.enabled}"><xacro:led_spots i="${0}" count="${21}"/></xacro:if>
  <!-- Six-axis measurement at base origin. Ideal GZ attitude is never fused. -->
  <gazebo reference="base_link">
    <sensor name="body_imu" type="imu">
      <topic>/sensors/imu/raw</topic><gz_frame_id>base_link</gz_frame_id>
      <always_on>true</always_on><update_rate>100</update_rate>
      <imu/>
    </sensor>
  </gazebo>
  <ros2_control name="GazeboSystem" type="system"><hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="interfaces" params="name">
      <joint name="${name}_steer_joint"><command_interface name="position"><param name="min">${p.steer_hard_lower}</param><param name="max">${p.steer_hard_upper}</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
      <joint name="${name}_drive_joint"><command_interface name="velocity"><param name="min">${-p.max_speed/p.wheel_radius}</param><param name="max">${p.max_speed/p.wheel_radius}</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
    </xacro:macro>
    <xacro:macro name="passive" params="name"><joint name="${name}_suspension_joint"><state_interface name="position"/><state_interface name="velocity"/></joint></xacro:macro>
    <xacro:passive name="fl"/><xacro:passive name="fr"/><xacro:passive name="rl"/><xacro:passive name="rr"/>
    <xacro:if value="${flexible}">
      <joint name="camera_roll_joint"><state_interface name="position"/><state_interface name="velocity"/></joint>
      <joint name="camera_pitch_joint"><state_interface name="position"/><state_interface name="velocity"/></joint>
    </xacro:if>
    <xacro:interfaces name="fl"/><xacro:interfaces name="fr"/><xacro:interfaces name="rl"/><xacro:interfaces name="rr"/>
  </ros2_control>
  <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(arg controllers)</parameters></plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame><odom_topic>/ground_truth/odom</odom_topic><tf_topic>/ground_truth/tf</tf_topic><odom_publish_frequency>50</odom_publish_frequency></plugin>
  </gazebo>
</robot>
