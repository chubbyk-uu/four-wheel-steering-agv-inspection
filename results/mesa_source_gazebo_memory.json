  "method": {
    "launch": "tools/with_mesa_runtime.py [--system] bash tools/with_optix_runtime.sh bash -c \"source ROS; ros2 launch agv_bringup sim.launch.py headless:=true rviz:=false linescan:=true linescan_backend:=optix spawn_x:=3 scene_manifest:=assets/road/runtime_fullwidth_100m_v1/manifest.json\"",
    "isolation": "separate ROS_DOMAIN_ID and GZ_PARTITION per arm; one simulation at a time",
    "settle": "30 s after the server is up, then /proc/<server>/smaps_rollup every 5 s for about 121 s",
    "server_selection": "largest-RSS match of \"gz sim\", required to be younger than this arm's launcher; an earlier run of this script sampled the previous arm's dying server and was discarded",
