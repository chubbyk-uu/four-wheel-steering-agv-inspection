 "residual_investigation": {
  "question": "what is the 0.2 to 0.9 percent by which the footprint ratio exceeds one",
  "mount_deflection_hypothesis": {
   "proposed_by": "user",
   "result": "falsified by the kinematic chain, not by statistics",
   "why": "agv.urdf.xacro puts camera_roll_joint and camera_pitch_joint upstream of camera_carrier_link, camera_link and camera_optical_frame. The tag's camera_position_world_m and camera_rotation_world are that optical frame's world pose, so they already contain the mount deflection, and the footprint solve consumes both. Mount flex cannot appear as a residual in a quantity that is computed from a pose which already includes it.",
   "corroboration": "the optical joint's fixed rpy of pi 0 pi/2 is exactly the quaternion Tag() applies, confirming the stored rotation is the optical frame and that its third column is the viewing direction"
  },
  "other_drivers_tested": {
   "pitch_rate_correlation": 0.2755,
   "pitch_magnitude_correlation": -0.0424,
   "interval_length_correlation": -0.3226,
   "reading": "no single-variable driver among these; an exposure-midpoint interpolation error would have tracked pitch rate and does not"
  },
