  "passed": true,
  "harness_defects_found": [
    "validate_rectangle_execution.py injected only at a hardcoded point in the first PASS, so no phase but the scan was ever exercised",
    "the rotate cancel asserted a stopping distance, which an in-place rotation trivially satisfies; it now asserts the yaw rate settles and records the yaw swept after the cancel",
    "the probe runner did not wrap scene runs in tools/with_optix_runtime.sh, so every OptiX probe aborted at optixInit(): 7804 before the mission began",
    "the probe runner deleted a failed attempt before retrying, destroying the only evidence of how it failed"
  ],
  "not_covered": [
    "localization timeout and camera-disabled faults were not re-run per phase; they remain validated only in the scan phase",
    "repeat counts, full-area runs and the rescan loop are separate acceptance items",
    "capture behaviour under pause is evidenced by one scene probe, not by every phase"
  ]
